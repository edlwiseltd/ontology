{
  "ontology": "ontology.json",
  "store": "autology.db",
  "data": "data.json",
  "agents": {
    "claims": {"roles": ["fraud_analytics", "finance", "claims_handler"], "tools": "tools.json",
               "goals": ["settle_claim"], "approver": "inbox"}
  },
  "users": [
    {"name": "hana", "token_env": "AUTOLOGY_TOKEN_HANA", "permissions": ["read", "run"], "roles": ["claims_handler"]},
    {"name": "ivan", "token_env": "AUTOLOGY_TOKEN_IVAN", "permissions": ["read", "review"],
     "reviewer_roles": ["special_investigations"]},
    {"name": "maria", "token_env": "AUTOLOGY_TOKEN_MARIA", "permissions": ["read", "review"],
     "roles": ["claims_handler"], "reviewer_roles": ["claims_manager"]},
    {"name": "admin", "token_env": "AUTOLOGY_TOKEN_ADMIN", "permissions": ["admin"]}
  ],
  "automations": {
    "settle_new_claims": {
      "description": "Start settling every claim as soon as it is reported",
      "entity": "Claim", "when": "Claim.status == 'reported'", "trigger": "change",
      "run": {"agent": "claims", "goal": "settle_claim", "case_template": "claim_case"},
      "notify": {"roles": ["claims_manager"], "message": "Claim {id} reported: settlement started"}
    }
  },
  "automation_interval": 60
}
