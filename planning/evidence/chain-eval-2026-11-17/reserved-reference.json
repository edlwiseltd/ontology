      "from": "Pilot",
      "to": "PilotageRequest",
      "type": "assigned_to",
      "cardinality": "1..*"
     }
    ],
    "actions": {
     "check_request": {
      "description": "The dispatcher checks the request",
      "capability": "ops.check_request",
      "requires": [
       "PilotageRequest.status == 'filed'"
      ],
      "effects": {
       "PilotageRequest": {
        "status": "checked"
       }
      },
      "side_effect": "none"
     },
     "assign_pilot": {
      "description": "Assign a pilot to the request",
      "capability": "ops.assign_pilot",
      "requires": [
       "PilotageRequest.status == 'checked'"
      ],
      "effects": {
       "PilotageRequest": {
        "status": "assigned"
       }
      },
      "side_effect": "none"
     },
     "confirm_boarding": {
      "description": "Confirm the boarding time",
      "capability": "ops.confirm_boarding",
      "requires": [
       "PilotageRequest.status == 'assigned'"
      ],
      "effects": {
       "PilotageRequest": {
        "status": "confirmed"
       }
      },
      "side_effect": "non_idempotent"
     }
    },
    "rules": [
