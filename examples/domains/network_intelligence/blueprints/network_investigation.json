{
 "id": "network_investigation",
 "name": "Commercial network investigation (synthetic template)",
 "description": "Take a compliance case from the extraction of relationships to a reviewed, auditable summary: an unusual pattern is flagged with its competing explanation, and a person decides every escalation. A training template on invented companies: it accuses nobody and proves nothing.",
 "keywords": [
  "investigat",
  "compliance",
  "invoice",
  "payment",
  "intermediar",
  "ownership",
  "contract",
  "fraud",
  "network of compan"
 ],
 "parameters": [
  {
   "id": "materiality_amount",
   "type": "number",
   "default": 10000,
   "question": "From which amount is an unusual pattern worth a case review?",
   "why": "Below it a pattern is noted, not flagged"
  },
  {
   "id": "reviewer_role",
   "type": "name",
   "default": "compliance_officer",
   "question": "Which role decides whether a case is escalated?",
   "why": "Every escalation waits for a named person: an association is never treated as proof"
  },
  {
   "id": "analyst_role",
   "type": "name",
   "default": "investigation_analyst",
   "question": "Which role works on cases day to day?",
   "why": "Only this role may prepare an escalation; the agent acts with it"
  },
  {
   "id": "financial_role",
   "type": "name",
   "default": "financial_investigator",
   "question": "Which role may see bank account records?",
   "why": "Account records are restricted: other roles do not see them"
  },
  {
   "id": "case_system",
   "type": "text",
   "default": "",
   "question": "Which system holds the case files (for example a case management system)?",
   "why": "Escalating a case acts outside Autology: it needs a tool, first simulated"
  }
 ],
