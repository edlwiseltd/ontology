# Copy to deploy/.env and replace every value. Never commit the real file.
# Generate tokens with: docker run --rm autology:local token
AUTOLOGY_AUDIT_KEY=replace-with-a-long-random-secret
AUTOLOGY_TOKEN_ADMIN=replace-me
AUTOLOGY_TOKEN_ETL=replace-me
AUTOLOGY_TOKEN_HANA=replace-me
AUTOLOGY_TOKEN_IVAN=replace-me
AUTOLOGY_TOKEN_MARIA=replace-me
# ANTHROPIC_API_KEY=...   only if the server config turns on the assistant or a model reasoner
