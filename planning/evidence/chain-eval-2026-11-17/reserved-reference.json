      "attributes": {
       "name": "string",
       "rest_hours": "number"
      }
     }
    },
    "relationships": [
     {
      "from": "Vessel",
      "to": "PilotageRequest",
      "type": "subject_of",
      "cardinality": "1..*"
     },
