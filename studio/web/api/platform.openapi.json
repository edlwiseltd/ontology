{
  "components": {
    "schemas": {
      "Check": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "passed",
          "detail"
        ],
        "type": "object"
      },
      "CheckResult": {
        "additionalProperties": true,
        "properties": {
          "allowed": {
            "type": "boolean"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/Check"
            },
            "type": "array"
          },
          "forward": {
            "type": "boolean"
          },
          "from": {
            "enum": [
              "draft",
              "simulation",
              "pilot",
              "production"
            ],
            "type": "string"
          },
          "to": {
            "enum": [
              "draft",
              "simulation",
              "pilot",
              "production"
            ],
            "type": "string"
          }
        },
        "required": [
          "from",
          "to",
          "forward",
          "checks",
          "allowed"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": true,
            "properties": {
              "code": {
                "type": "string"
              },
              "details": {
                "additionalProperties": true,
                "type": "object"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "type": "integer"
              }
            },
            "required": [
              "status",
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Health": {
        "additionalProperties": true,
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "Me": {
        "additionalProperties": true,
        "properties": {
          "member": {
            "type": "string"
          },
          "use_cases": {
            "items": {
              "additionalProperties": true,
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "ontology": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "permissions": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "stage": {
                  "enum": [
                    "draft",
                    "simulation",
                    "pilot",
                    "production"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "stage",
                "path"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "workspace": {
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ],
            "type": "object"
          },
          "workspace_admin": {
            "type": "boolean"
          }
        },
        "required": [
          "workspace",
          "member",
          "workspace_admin",
          "use_cases"
        ],
        "type": "object"
      },
      "MoveResult": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CheckResult"
          },
          {
            "additionalProperties": true,
            "properties": {
              "use_case": {
                "$ref": "#/components/schemas/UseCase"
              }
            },
            "required": [
              "use_case"
            ],
            "type": "object"
          }
        ]
      },
      "StageEvent": {
        "additionalProperties": true,
        "properties": {
          "at": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/Check"
            },
            "type": "array"
          },
          "fingerprint": {
            "type": "string"
          },
          "from_stage": {
            "enum": [
              "draft",
              "simulation",
              "pilot",
              "production"
            ],
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "seq": {
            "type": "integer"
          },
          "to_stage": {
            "enum": [
              "draft",
              "simulation",
              "pilot",
              "production"
            ],
            "type": "string"
          }
        },
        "required": [
          "seq",
          "from_stage",
          "to_stage",
          "by",
          "reason",
          "at"
        ],
        "type": "object"
      },
      "StageMove": {
        "additionalProperties": true,
        "properties": {
          "reason": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "to": {
            "enum": [
              "draft",
              "simulation",
              "pilot",
              "production"
            ],
            "type": "string"
          }
        },
        "required": [
          "to",
          "reason"
        ],
        "type": "object"
      },
      "Template": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "type": "object"
      },
      "TemplateList": {
        "additionalProperties": true,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Template"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "UseCase": {
        "additionalProperties": true,
        "properties": {
          "effective_stage": {
            "enum": [
              "draft",
              "simulation",
              "pilot",
              "production"
            ],
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/StageEvent"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "integrity_problem": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "ontology": {
            "type": "string"
          },
          "origin": {
            "enum": [
              "configuration",
              "template"
            ],
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "stage": {
            "enum": [
              "draft",
              "simulation",
              "pilot",
              "production"
            ],
            "type": "string"
          },
          "stages": {
            "items": {
              "enum": [
                "draft",
                "simulation",
                "pilot",
                "production"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "stale": {
            "type": "boolean"
          },
          "template": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "origin",
          "ontology",
          "fingerprint",
          "path",
          "permissions",
          "stage",
          "effective_stage",
          "stale",
          "stages"
        ],
        "type": "object"
      },
      "UseCaseCreate": {
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "template": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "template"
        ],
        "type": "object"
      },
      "UseCaseList": {
        "additionalProperties": true,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/UseCase"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Workspaces, use cases and lifecycle stages. Each use case's engine API is served behind /w/{workspace}/u/{use case} (see the engine contract).",
    "title": "Autology platform API",
    "version": "1"
  },
  "openapi": "3.1.0",
