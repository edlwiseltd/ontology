{
  "registries": [
    {
      "target": "autology.scheduling:scheduling_tools",
      "kwargs": {
        "ontology": "ontology.json",
        "data": "data.json",
        "solver": "builtin",
        "time_limit": 2,
        "out_dir": "out",
        "rework": {
          "event": "QualityReturn",
          "source": "returnOf",
          "link": "reworks",
          "from_seq": "from_seq"
        }
      },
      "path_kwargs": [
        "ontology",
        "data",
        "out_dir"
      ]
    }
  ],
  "_comment": "pilot environment: built-in solver for fast, deterministic CI; the MES web API is unreachable, so publishing falls back to the file drop",
  "tools": [
    {
      "name": "mes_api",
      "capability": "scheduling.publish",
      "type": "http",
      "url": "http://127.0.0.1:9/mes/schedules",
      "timeout": 1,
      "priority": 5,
      "cost": 0.05
    }
  ]
}
