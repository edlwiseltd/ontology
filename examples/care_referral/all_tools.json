{
  "tools": [
    {
      "name": "consent_portal",
      "capability": "consent.record",
      "type": "table",
      "cost": 0.2,
      "rows": [
        {
          "message": "consent recorded in the patient portal"
        }
      ]
    },
    {
      "name": "triage_rules",
      "capability": "clinical.triage",
      "type": "table",
      "cost": 0.5,
      "rows": [
        {
          "when": "Patient.age >= 75 or Patient.condition == 'chest pain'",
          "outcome": "urgent",
          "message": "red-flag criteria met: urgent pathway"
        },
        {
          "outcome": "routine",
          "message": "routine pathway"
        }
      ]
    },
    {
      "name": "ehr_referral",
      "capability": "ehr.referral",
      "type": "table",
      "cost": 0.3,
      "rows": [
        {
          "message": "referral sent via the e-referral service"
        }
      ]
    },
    {
      "name": "specialist_desk",
      "capability": "specialist.review",
      "type": "table",
      "cost": 15,
      "rows": [
        {
          "when": "Referral.alternate != True and Patient.condition == 'non-specific'",
          "outcome": "rejected",
          "message": "insufficient detail for this specialty"
        },
        {
          "outcome": "accepted",
          "message": "referral accepted"
        }
      ]
    },
    {
      "name": "care_plan_builder",
      "capability": "clinical.care_plan",
      "type": "table",
      "cost": 2,
      "rows": [
        {
          "message": "care plan drafted from the pathway template"
        }
      ]
    },
    {
      "name": "ehr_admit",
      "capability": "ehr.admit",
      "type": "table",
      "cost": 0.2,
      "rows": [
        {
          "when": "Patient.age >= 41 and Patient.age <= 45",
          "error": "EHR admission API timeout"
        },
        {
          "message": "patient admitted to the specialist pathway"
        }
      ]
    },
    {
      "name": "admissions_desk",
      "capability": "ehr.admit",
      "type": "table",
      "cost": 6,
      "rows": [
        {
          "message": "admitted manually by the admissions desk"
        }
      ]
    },
    {
      "name": "booking_office",
      "capability": "scheduling.book",
      "type": "table",
      "cost": 0.5,
      "rows": [
        {
          "when": "Referral.urgency == 'urgent'",
          "updates": {
            "Appointment": {
              "slot": "within 2 weeks"
            }
          },
          "message": "urgent slot booked"
        },
        {
          "updates": {
            "Appointment": {
              "slot": "within 8 weeks"
            }
          },
          "message": "routine slot booked"
        }
      ]
    }
  ]
}
