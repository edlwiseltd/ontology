  {
   "kind": "action",
   "name": "extract_relationships",
   "rationale": "Extract the relationships between the parties of the case",
   "value": {
    "description": "Extract the relationships between the parties of the case",
    "capability": "analysis.extract",
    "requires": [
     "CaseFile.status == 'opened'"
    ],
    "effects": {
     "CaseFile": {
      "status": "relationships_extracted"
     }
    },
    "side_effect": "none"
   }
  },
  {
   "kind": "action",
   "name": "close_without_finding",
   "rationale": "Close the case: nothing unusual was found",
   "value": {
    "description": "Close the case: nothing unusual was found",
    "capability": "reporting.close",
    "requires": [
     "CaseFile.status == 'relationships_extracted'",
     "CaseFile.unusual_links == 0"
    ],
    "effects": {
     "CaseFile": {
      "status": "summarised",
      "summary_note": "closed without finding"
     }
    },
    "side_effect": "idempotent"
   }
  },
  {
   "kind": "action",
   "name": "flag_unusual_pattern",
   "rationale": "Flag a pattern that merits examination (a flag is not a finding)",
   "value": {
    "description": "Flag a pattern that merits examination (a flag is not a finding)",
    "capability": "analysis.flag",
    "requires": [
     "CaseFile.status == 'relationships_extracted'",
     "CaseFile.unusual_links > 0",
     "CaseFile.unusual_amount >= {materiality_amount}"
    ],
    "effects": {
     "CaseFile": {
      "status": "pattern_flagged"
     }
    },
    "side_effect": "none"
   }
  },
  {
   "kind": "action",
   "name": "record_alternative_explanation",
   "rationale": "Record the competing, innocent explanation beside the hypothesis",
   "value": {
    "description": "Record the competing, innocent explanation beside the hypothesis",
    "capability": "analysis.alternatives",
    "requires": [
     "CaseFile.status == 'pattern_flagged'",
     "Hypothesis.status == 'open'"
    ],
    "effects": {
     "CaseFile": {
      "status": "alternatives_recorded",
      "alternative_recorded": "True"
     }
    },
    "side_effect": "none"
   }
  },
  {
   "kind": "action",
   "name": "escalate_for_investigation",
   "rationale": "Ask for the case to be escalated to a formal investigation",
   "value": {
    "description": "Ask for the case to be escalated to a formal investigation",
    "capability": "cases.escalate",
    "requires": [
     "CaseFile.status == 'alternatives_recorded'"
    ],
    "effects": {
     "CaseFile": {
      "status": "escalated"
     }
    },
    "side_effect": "non_idempotent"
   }
  },
  {
   "kind": "action",
   "name": "write_summary",
   "rationale": "Write the investigative summary: facts, inferences, alternatives, the decision",
   "value": {
    "description": "Write the investigative summary: facts, inferences, alternatives, the decision",
    "capability": "reporting.summary",
    "requires": [
     "CaseFile.status == 'escalated'"
    ],
    "effects": {
     "CaseFile": {
      "status": "summarised",
      "summary_note": "summary written after review"
     }
    },
    "side_effect": "idempotent"
   }
  },
  {
   "kind": "rule",
   "rationale": "A {reviewer_role} decides every escalation: no association is treated as proof",
   "uses": [
    "reviewer_role"
   ],
   "value": {
    "id": "R-ESCALATION-REVIEW",
    "type": "human_review",
    "action": "escalate_for_investigation",
    "reviewer": "{reviewer_role}",
    "description": "A {reviewer_role} decides every escalation: no association is treated as proof"
   }
  },
  {
   "kind": "rule",
   "rationale": "A case that rests only on unverified evidence is never escalated",
   "uses": [],
   "value": {
    "id": "R-NO-UNVERIFIED",
    "type": "prohibition",
    "action": "escalate_for_investigation",
    "when": "CaseFile.evidence_quality == 'unverified'",
    "description": "A case that rests only on unverified evidence is never escalated"
   }
  },
  {
   "kind": "rule",
   "rationale": "The competing explanation is recorded before any escalation",
   "uses": [],
   "value": {
    "id": "R-ALTERNATIVE-FIRST",
    "type": "mandatory_step",
    "step": "record_alternative_explanation",
    "before": "escalate_for_investigation",
    "description": "The competing explanation is recorded before any escalation"
   }
  },
  {
   "kind": "rule",
   "rationale": "Only a {analyst_role} prepares an escalation",
   "uses": [
    "analyst_role"
   ],
   "value": {
    "id": "R-ESCALATE-ROLE",
    "type": "action_access",
    "action": "escalate_for_investigation",
    "roles": [
     "{analyst_role}"
    ],
    "description": "Only a {analyst_role} prepares an escalation"
   }
  },
  {
   "kind": "rule",
   "rationale": "Only a {financial_role} sees bank account records",
   "uses": [
    "financial_role"
   ],
   "value": {
    "id": "R-ACCOUNT-ROWS",
    "type": "row_access",
    "entity": "BankAccount",
    "roles": [
     "{financial_role}"
    ],
    "description": "Only a {financial_role} sees bank account records"
   }
  },
  {
   "kind": "rule",
   "rationale": "Only a {analyst_role} changes the count of unusual links",
   "uses": [
    "analyst_role"
   ],
   "value": {
    "id": "R-FLAG-FIGURES",
    "type": "write_access",
    "field": "CaseFile.unusual_links",
    "roles": [
     "{analyst_role}"
    ],
    "description": "Only a {analyst_role} changes the count of unusual links"
   }
  },
  {
   "kind": "goal",
   "name": "case_summarised",
   "rationale": "The outcome asked for",
   "value": {
    "description": "The case has an auditable summary",
    "target": "CaseFile.status == 'summarised'"
   }
  },
  {
   "kind": "case_template",
   "name": "investigation_case",
   "rationale": "A run starts from one case file",
   "value": {
    "description": "A case file with its hypotheses and its evidence",
    "root": "CaseFile",
    "entities": {
     "CaseFile": "self",
     "Hypothesis": "hypotheses",
     "Evidence": "evidence"
    }
   }
  }
 ],
