   "quantity": 1
  }
 },
 "solution": {
  "agents": {
   "response_coordinator": {
    "purpose": "Takes an incident report to an assigned response and a published update, within the policy",
    "responsibilities": [
     "Validate the report",
     "Identify usable teams and equipment",
     "Propose an allocation",
     "Assign a team, or ask the person the policy names",
     "Publish an update"
    ],
    "roles": [
     "{operations_role}"
    ],
    "goals": [
     "incident_handled"
    ],
    "autonomy": {
     "mode": "policy"
    },
    "tools": [
     {
      "action": "validate_report",
      "tool": "simulated.succeed",
      "message": "report checked against its source (simulated: nothing left Autology)"
     },
     {
      "action": "identify_resources",
      "tool": "simulated.fail",
      "when": "IncidentReport.simulate_outage == True",
      "error": "the resource register is not reachable (simulated outage)"
     },
     {
      "action": "propose_allocation",
      "tool": "simulated.succeed",
      "message": "allocation proposed as a recommendation (simulated: nothing left Autology)"
     },
     {
      "action": "assign_response_team",
      "tool": "simulated.succeed",
      "message": "assignment recorded; nobody was dispatched (simulated: nothing left Autology)"
     },
     {
      "action": "publish_update",
      "tool": "simulated.succeed",
      "message": "update published to the coordination centre only (simulated: nothing left Autology)"
     }
    ]
   }
  },
