{
  "ontology": "ontology.json",
  "store": "autology.db",
  "data": "data.json",
  "agents": {
    "fulfilment": {"roles": ["ops", "eu_ops", "finance"], "tools": "tools.json",
                   "goals": ["fulfil_contract"], "approver": "inbox"}
  },
  "users": [
    {"name": "olivia", "token_env": "AUTOLOGY_TOKEN_OLIVIA", "permissions": ["read", "run"], "roles": ["ops"]},
    {"name": "lena", "token_env": "AUTOLOGY_TOKEN_LENA", "permissions": ["read", "review"],
     "roles": ["ops", "eu_ops"], "reviewer_roles": ["logistics_manager"]},
    {"name": "audrey", "token_env": "AUTOLOGY_TOKEN_AUDREY", "permissions": ["read", "audit"], "roles": ["finance"]},
    {"name": "admin", "token_env": "AUTOLOGY_TOKEN_ADMIN", "permissions": ["admin"]}
  ],
  "automations": {
    "fulfil_signed_contracts": {
      "description": "Fulfil every order of a contract as soon as the contract is signed",
      "entity": "Contract", "when": "Contract.status == 'signed'", "trigger": "change",
      "run": {"agent": "fulfilment", "goal": "fulfil_contract", "case_template": "contract_case"},
      "notify": {"roles": ["logistics_manager"], "message": "Contract {id} is signed: fulfilment started"}
    },
    "large_order_watch": {
      "description": "Remind finance of large orders still waiting for a credit check",
      "entity": "Order", "when": "Order.amount > 50000 and Order.status == 'received'", "trigger": {"every": 3600},
      "notify": {"roles": ["finance"], "message": "Order {id} for {amount} is still waiting for a credit check"}
    }
  },
  "automation_interval": 60,
  "chat": {"model": "claude-opus-5-5", "effort": "medium"}
}
